# Variables d'environnement de PRODUCTION (a copier vers .env.prod et completer).
# Lancement: docker compose -f docker-compose.prod.yml --env-file .env.prod up --build -d

# Base de donnees
POSTGRES_DB=sermon_db
POSTGRES_USER=sermon_user
POSTGRES_PASSWORD=changez_ce_mot_de_passe_fort
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
# ATTENTION : cette cle signe aussi les jetons de connexion (JWT, HS256).
# Minimum 32 caracteres, sinon le demarrage echoue en production.
# Generer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=generez_une_cle_secrete_longue_et_aleatoire
DJANGO_ALLOWED_HOSTS=votre-domaine.org,www.votre-domaine.org
# Origines autorisees (CORS) et de confiance (CSRF)
CORS_ALLOWED_ORIGINS=https://votre-domaine.org
CSRF_TRUSTED_ORIGINS=https://votre-domaine.org
FRONTEND_URL=https://votre-domaine.org
# Mettre a False si le TLS est gere ailleurs et qu'aucune redirection n'est souhaitee
SECURE_SSL_REDIRECT=True

# Cle API YouTube Data v3 (commande import_youtube_videos et synchro planifiee)
GOOGLE_API_KEY=

# Email (SMTP reel en production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.votre-fournisseur.org
EMAIL_PORT=587
EMAIL_HOST_USER=identifiant
EMAIL_HOST_PASSWORD=secret
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@votre-domaine.org

# Stockage objet S3 + CDN (optionnel)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
