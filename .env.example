POSTGRES_DB=sermon_db
POSTGRES_USER=sermon_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

VITE_API_URL=http://localhost:8000/api

# Cle API YouTube Data v3 (necessaire pour la commande import_youtube_videos).
# A obtenir dans Google Cloud Console > APIs & Services > Credentials.
GOOGLE_API_KEY=

# Email (optionnel en dev: backend console par defaut, les emails s'affichent dans les logs backend).
# URL publique du front, utilisee pour les liens de verification email et de reinitialisation.
FRONTEND_URL=http://localhost:5173
