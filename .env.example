POSTGRES_DB=sermon_db
POSTGRES_USER=sermon_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cette cle signe aussi les jetons de connexion (JWT, HS256) : 32 caracteres minimum.
# Generer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

VITE_API_URL=http://localhost:8000/api

# Cle API YouTube Data v3 (necessaire pour la commande import_youtube_videos).
# A obtenir dans Google Cloud Console > APIs & Services > Credentials.
GOOGLE_API_KEY=

# Email. URL publique du front, utilisee pour les liens de verification email et de reinitialisation.
FRONTEND_URL=http://localhost:5173
# En dev, les emails partent vers le conteneur MailDev (docker-compose.yml) au
# lieu d'un vrai serveur : rien n'est reellement envoye, tout est consultable
# sur http://localhost:1080. Ce sont deja les valeurs par defaut de
# docker-compose.yml, inutile de les redefinir sauf pour les changer :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=maildev
# EMAIL_PORT=1025
#
# En production, configurer un vrai SMTP:
# DEFAULT_FROM_EMAIL=no-reply@votre-domaine.org
# EMAIL_HOST=smtp.votre-domaine.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# EMAIL_USE_TLS=True
